# BTagent backend — multi-stage build
#
# Supply chain: base image is pinned via build-arg so prod builds can lock to
# a specific digest without editing the file. Default is the minor-version
# tag, which still floats on patch releases. To fully lock, set
# ``BASE_IMAGE_DIGEST`` in CI to the output of:
#
#     docker pull python:3.14-slim-bookworm
#     docker inspect --format='{{index .RepoDigests 0}}' python:3.14-slim-bookworm
#
# and pass it as ``--build-arg BASE_IMAGE_DIGEST=sha256:...``.
ARG BASE_IMAGE=python:3.14-slim-bookworm
ARG BASE_IMAGE_DIGEST=

# Stage 1: Build
FROM ${BASE_IMAGE}${BASE_IMAGE_DIGEST:+@${BASE_IMAGE_DIGEST}} AS builder

WORKDIR /app
RUN pip install --no-cache-dir uv

# Install the four workspace packages editable, in dependency order:
#   shared -> engine -> agents -> backend
# This mirrors .github/workflows/ci.yml. ``engine`` must precede ``agents``
# because ``btagent-engine`` is a runtime dep of ``btagent-agents``, and the
# backend imports both ``btagent_agents`` (task_manager, report_service,
# playbook_service, scheduler.jobs) and ``btagent_engine`` (ws adapter,
# models_workflow) at runtime — so all four must be present or the container
# crashes on first import.
#
# Each package's source is copied before its install so the editable install
# resolves against the local tree (not PyPI, where these don't exist).

# shared (no internal deps)
COPY shared/pyproject.toml shared/
COPY shared/btagent_shared/ shared/btagent_shared/
RUN cd shared && uv pip install --system -e .

# engine (depends on shared) — pulls in pyyaml etc.
COPY engine/pyproject.toml engine/
COPY engine/btagent_engine/ engine/btagent_engine/
RUN cd engine && uv pip install --system -e .

# agents (depends on shared + engine) — pulls in the heavy runtime deps:
# langgraph, litellm, langchain-*, pysigma*.
COPY agents/pyproject.toml agents/
COPY agents/btagent_agents/ agents/btagent_agents/
RUN cd agents && uv pip install --system -e .

# backend (depends on shared) — FastAPI app, migrations, scheduler.
COPY backend/pyproject.toml backend/
COPY backend/btagent_backend/ backend/btagent_backend/
COPY backend/alembic.ini backend/
COPY backend/migrations/ backend/migrations/
RUN cd backend && uv pip install --system -e .

# Same CVE floors the final stage applies (see the note there). Correct here on
# its own merits: without it this stage ships msgpack 1.1.2, so an intermediate
# build artifact carries a package with a known HIGH advisory even though the
# runtime image does not.
RUN pip install --no-cache-dir --upgrade "setuptools>=78.1.1" "msgpack>=1.2.1"

# Stage 2: Production
FROM ${BASE_IMAGE}${BASE_IMAGE_DIGEST:+@${BASE_IMAGE_DIGEST}}

# Security: non-root user
RUN useradd --create-home --shell /bin/bash --uid 1000 btagent
WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.14/site-packages/ /usr/local/lib/python3.14/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/
COPY --from=builder /app/ /app/

# Supply-chain floors for two packages no ``pyproject.toml`` can pin:
# ``setuptools`` ships inside the base image itself, and ``msgpack`` arrives
# transitively through the agent runtime.
#
# 2026-08-05 — setuptools CVE-2025-47273 (path traversal in PackageIndex,
# fixed 78.1.1) and msgpack GHSA-6v7p-g79w-8964 (out-of-bounds read on
# Unpacker reuse, fixed 1.2.1). Drop an entry once the upstream that pulls it
# in ships a version at or above the floor.
#
# WHY THIS STEP IS LOAD-BEARING, precisely — the honest version, because the
# first four attempts at it were all written against mechanisms that turned
# out to be wrong:
#
# It does NOT exist to clear the image scan. The scan findings for these two
# packages were SBOM-sourced: their Trivy records carry ``PkgPath: null`` and
# a ``BOMRef``, meaning they came from a wheel's vendored CycloneDX document
# describing its *build* environment, not from anything installed here. They
# are suppressed in ``.trivyignore.yaml``, not fixed by this step.
#
# It exists because that suppression needs a compensating control. The
# suppression's argument is "the image genuinely ships patched versions", and
# this step is what makes that true and *keeps* it true: the upgrade, the
# image-wide sweep of superseded metadata, and the assertion that exactly one
# metadata directory survives at or above the floor. If this step is weakened,
# the suppression silently becomes a real blind spot — which is why
# ``backend/tests/test_trivyignore_justified.py`` fails when the floors or the
# assertion disappear.
#
# Two implementation details, both learned by getting them wrong:
#
#   * ``pip``, not ``uv``. ``uv pip install --upgrade`` reported
#     ``+ setuptools==83.0.0`` with no matching ``-`` line — it *added* the new
#     distribution rather than replacing the copied-in one, because a package
#     that arrived via ``COPY --from`` was never installed from uv's point of
#     view. pip performs a real uninstall of what it finds on disk.
#   * The sweep runs in the FINAL stage. ``COPY --from`` merges into the
#     destination and cannot delete, so doing this in the builder alone leaves
#     the base image's own copy in place underneath.
#
# The verification fails the build if a floor is unmet or a superseded
# metadata directory survives. Earlier attempts were silent no-ops whose only
# symptom was a scanner reporting unchanged versions; a supply-chain step that
# quietly does nothing is worse than one that fails loudly.
RUN python -m pip install --no-cache-dir --upgrade \
        "setuptools>=78.1.1" "msgpack>=1.2.1" \
    && for pkg in setuptools msgpack; do \
         keep="$(python -c "import importlib.metadata as m; print(m.version('$pkg'))")"; \
         echo "== $pkg: resolved $keep; metadata found in image:"; \
         find / -xdev \( -path /proc -o -path /sys \) -prune -o \
              -maxdepth 12 -type d \
              \( -name "$pkg-*.dist-info" -o -name "$pkg-*.egg-info" \) -print \
         | while read -r d; do \
             echo "   $d"; \
             case "$d" in \
               *"-$keep.dist-info"|*"-$keep.egg-info") ;; \
               *) echo "   ^ superseded, removing"; rm -rf "$d" ;; \
             esac; \
           done; \
         n=$(find / -xdev \( -path /proc -o -path /sys \) -prune -o \
                 -maxdepth 12 -type d \
                 \( -name "$pkg-*.dist-info" -o -name "$pkg-*.egg-info" \) -print \
             | wc -l); \
         [ "$n" = "1" ] || { echo "expected exactly 1 $pkg metadata dir, found $n"; exit 1; }; \
       done \
    && python -c "\
import importlib.metadata as m;\
v = lambda n: tuple(int(p) for p in m.version(n).split('.')[:3]);\
assert v('setuptools') >= (78, 1, 1), m.version('setuptools');\
assert v('msgpack') >= (1, 2, 1), m.version('msgpack');\
print('remediated:', m.version('setuptools'), m.version('msgpack'))"

# Set ownership
RUN chown -R btagent:btagent /app

USER btagent

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import httpx; r = httpx.get('http://localhost:8000/health'); r.raise_for_status()"

CMD ["uvicorn", "btagent_backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
