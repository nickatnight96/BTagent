# BTagent local stack environment.
#
#   cp infra/.env.example infra/.env   # then edit — .env is gitignored
#
# The values below are DEV DEFAULTS. Anything marked "generate per-install"
# must be replaced before the stack is reachable by anything but your own
# loopback interface. See docs/deployment/ for the hardened one-box recipe.

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=btagent
POSTGRES_PASSWORD=btagent_dev_password
POSTGRES_DB=btagent
BTAGENT_DATABASE_URL=postgresql+asyncpg://btagent:btagent_dev_password@postgres:5432/btagent

# ── Redis ─────────────────────────────────────────────────
BTAGENT_REDIS_URL=redis://redis:6379

# ── MinIO (S3-compatible evidence storage) ────────────────
# `minioadmin` is MinIO's publicly-documented default on BOTH halves of the
# pair. Outside dev/test the config validator refuses to boot if EITHER the
# access key or the secret key is still `minioadmin` — this bucket holds the
# chain-of-custody evidence artifacts.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
BTAGENT_S3_ENDPOINT=http://minio:9000
BTAGENT_S3_ACCESS_KEY=minioadmin
BTAGENT_S3_SECRET_KEY=minioadmin

# ── Auth ──────────────────────────────────────────────────
# GENERATE PER INSTALL:  openssl rand -hex 32
# This key signs every session token. The value shipped below is a known
# default: anyone who has read this repository can mint an admin token against
# a backend still using it. In dev the config validator only warns; outside
# dev/test it refuses to start.
BTAGENT_JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# GENERATE PER INSTALL, SEPARATELY:  openssl rand -hex 32
# Shared secret for the `/api/v1/webhooks/*` ingestion endpoints, sent by the
# SIEM/EDR in the `X-Webhook-Secret` header.
#
# It MUST be a different value from BTAGENT_JWT_SECRET (the config validator
# rejects equality outside dev/test). The webhook secret gets pasted into every
# SIEM alert-action config, so it has the blast radius of a shared password;
# the JWT key has the blast radius of a root key. If they are the same value,
# anyone who can read an alert-action config can forge admin sessions.
#
# Leave it EMPTY to keep webhook ingestion off: an empty value is read as
# "unset", and with no secret configured the webhook endpoints reject every
# request with 401, in all environments. There is deliberately no dev fallback
# to the JWT key.
BTAGENT_WEBHOOK_SECRET=

# Password for the seeded `admin` user, read by the bootstrap/seed scripts.
# In BTAGENT_ENV=test the seed password is deterministic (it equals the
# username) for CI; in every other environment the seed refuses to run unless
# this is set, rather than minting a random password that locks you out.
#   export BTAGENT_SEED_ADMIN_PASSWORD=$(openssl rand -base64 24)
BTAGENT_SEED_ADMIN_PASSWORD=

# ── LLM Providers ────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
OLLAMA_HOST=http://ollama:11434

# Deterministic engine LLM mock. Default `true` — the agent's reasoning nodes
# use their mock path and NOTHING is sent to a model provider. Only an explicit
# `false` switches to live dispatch (a typo or empty value keeps mocks on, so a
# misconfiguration can never cause egress).
BTAGENT_MOCK_LLM=true

# Base URL of the local model server. Read by the embedding service AND by the
# chat-completion path (passed to LiteLLM as api_base). Before this was wired,
# chat silently pinned itself to localhost:11434 regardless of this value.
# Inside the compose network the host is the service name, not localhost.
BTAGENT_OLLAMA_BASE_URL=http://ollama:11434

# Restrict LLM routing to local providers (ollama / vllm) and FAIL CLOSED: a
# request whose TLP level authorises no local provider raises RoutingError
# rather than falling through to a hosted provider. Default `false`. Set `true`
# for a sovereign / air-gapped posture — without it, "no cloud egress" is only
# a property of the provider credentials above being blank.
BTAGENT_LOCAL_LLM_ONLY=false

# ── App ───────────────────────────────────────────────────
# dev | test | staging | prod. `production` is accepted as a synonym for
# `prod`. This value drives real enforcement — prod turns on HSTS, disables
# /api/docs, rejects legacy tokens that cannot be revoked, and requires an
# explicit CORS allowlist.
BTAGENT_ENV=dev
BTAGENT_LOG_LEVEL=info
BTAGENT_MOCK_CONNECTORS=true

# Browser origins allowed to call the API, as a JSON array. Cookie auth
# requires allow_credentials=True, which means this must be an explicit list —
# `*` is rejected at startup, and so is an empty value (pydantic cannot parse
# `` as a list; either give a real array or delete the line to take the
# built-in localhost dev defaults). In prod an explicit allowlist is mandatory.
# Production example: ["https://btagent.example.com"]
BTAGENT_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Escape hatch for a SINGLE-MACHINE prod deployment. In prod a localhost /
# 127.0.0.1 CORS origin is normally fatal, because it almost always means the
# allowlist was never configured. On a one-box compose install the analyst's
# browser really is on the same host and the SPA origin really is
# http://localhost:8080, so set this to `true` — deliberately — to allow it.
# Leave it `false` anywhere the browser is on a different machine.
BTAGENT_ALLOW_LOCAL_ORIGINS=false

# ── Observability (optional) ─────────────────────────────
BTAGENT_OTEL_ENABLED=false
BTAGENT_LANGFUSE_ENABLED=false
# Bearer token gating the Prometheus /metrics scrape. Leave empty to keep the
# endpoint open (dev/compose). Set it in any deployment that publishes :8000
# beyond the host — /metrics is otherwise reachable by anyone who can reach it.
BTAGENT_METRICS_TOKEN=

# ── Slack (optional) ─────────────────────────────────────
BTAGENT_SLACK_BOT_TOKEN=
BTAGENT_SLACK_CHANNEL=

# Optional: enable Redis AUTH. When set, compose starts redis with
# --requirepass and BTAGENT_REDIS_URL must carry the same password
# (redis://:PASSWORD@redis:6379). Leave empty for no auth.
# REDIS_PASSWORD=
