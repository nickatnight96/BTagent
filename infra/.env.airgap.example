# Air-gapped stack environment — Sovereign Pack (#502).
# Copy to `.env.airgap`, replace every REPLACE_ME, then:
#   docker compose -f docker-compose.airgap.yml --env-file .env.airgap up -d
#
# See docs/deployment/air-gap.md. `.env.airgap` is gitignored; this example
# never carries real material.

# ── Digest-pinned images ──────────────────────────────────
# Produced by infra/scripts/airgap-bundle.sh on the connected side and recorded
# in the bundle manifest. A digest ref is immutable: what you reviewed is what
# runs. Format: <repo>@sha256:<64 hex>
IMAGE_POSTGRES=REPLACE_ME   # e.g. pgvector/pgvector@sha256:...
IMAGE_REDIS=REPLACE_ME      # e.g. redis@sha256:...
IMAGE_MINIO=REPLACE_ME      # e.g. minio/minio@sha256:...
IMAGE_OLLAMA=REPLACE_ME     # e.g. ollama/ollama@sha256:...
IMAGE_NGINX=REPLACE_ME      # e.g. nginx@sha256:...
IMAGE_BACKEND=REPLACE_ME    # e.g. ghcr.io/<org>/btagent-backend@sha256:...
IMAGE_FRONTEND=REPLACE_ME   # e.g. ghcr.io/<org>/btagent-frontend@sha256:...

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=btagent
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=btagent

# ── MinIO (S3-compatible evidence storage) ────────────────
MINIO_ROOT_USER=btagent
MINIO_ROOT_PASSWORD=REPLACE_ME
BTAGENT_S3_ACCESS_KEY=btagent
BTAGENT_S3_SECRET_KEY=REPLACE_ME

# ── Auth ──────────────────────────────────────────────────
# openssl rand -hex 32
BTAGENT_JWT_SECRET=REPLACE_ME
# MUST differ from BTAGENT_JWT_SECRET — reusing one value for both lets a
# webhook signer mint session tokens.
BTAGENT_WEBHOOK_SECRET=REPLACE_ME

# ── App posture ───────────────────────────────────────────
BTAGENT_ENV=production
BTAGENT_LOG_LEVEL=info

# Deterministic connector fixtures — the default, and the posture verified by
# backend/tests/test_zero_egress.py. Flip to false only after every connector
# is bound to a system INSIDE the enclave.
BTAGENT_MOCK_CONNECTORS=true

# Deterministic engine LLM mock. Set to false once the local model server is
# serving (air-gap.md §4.5).
BTAGENT_MOCK_LLM=false

# ── Local models ──────────────────────────────────────────
# Two traps (air-gap.md §4.2/§4.3):
#  1. With BTAGENT_MOCK_CONNECTORS=true the embedding factory returns the
#     deterministic MockEmbeddingService and IGNORES the provider below.
#     Mock vectors are hash expansions: stable, and useless for retrieval.
#     These keys take effect only once connector mocks are off.
#  2. BOTH keys are required. BTAGENT_EMBEDDING_MODEL defaults to an OpenAI
#     model name, so setting only the provider hands "text-embedding-3-small"
#     to your local server and every embed call fails.
BTAGENT_EMBEDDING_PROVIDER=ollama
BTAGENT_EMBEDDING_MODEL=nomic-embed-text
# Read by the embedding service AND by the chat-completion router: the backend
# passes it into the LiteLLM call as api_base (air-gap.md §4.5).
BTAGENT_OLLAMA_BASE_URL=http://ollama:11434
# Belt and braces for anything that reaches LiteLLM without going through the
# router (LiteLLM reads this itself). Harmless to leave set.
OLLAMA_HOST=http://ollama:11434

# Restrict LLM routing to local providers (ollama / vllm) and FAIL CLOSED: a
# request whose TLP level authorises no local provider raises RoutingError
# instead of resolving to a hosted provider. Without this, "no cloud egress"
# depends only on the credentials below being absent. Default is false;
# an air-gapped install should set it true.
BTAGENT_LOCAL_LLM_ONLY=true

# No hosted-provider credentials in an air-gapped install. Left blank
# deliberately — a stray key here is a live egress path waiting for a
# misconfiguration.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AZURE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Observability ─────────────────────────────────────────
# Point at an in-enclave collector or leave off. Langfuse defaults to a hosted
# endpoint, so it stays off.
BTAGENT_OTEL_ENABLED=false
BTAGENT_LANGFUSE_ENABLED=false

# ── Outbound integrations (unavailable offline) ───────────
BTAGENT_SLACK_BOT_TOKEN=
BTAGENT_SLACK_CHANNEL=
